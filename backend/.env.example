# Conta usada para e-mails de ALUNOS/PROFESSORES (recuperação de senha,
# notificações de empréstimo/devolução/reserva/atraso).
# Opção simples (mesmo Gmail, só muda o nome do remetente): deixe
# SMTP_USER_ALUNOS e SMTP_PASS_ALUNOS em branco e preencha só a linha abaixo:
SMTP_FROM_ALUNOS=BiblioBeta Alunos e Professores <bibliobeta20@gmail.com>

# Opção avançada (Gmail totalmente separado): preencha as três linhas abaixo.
# Se preenchidas, elas têm prioridade sobre a opção simples acima.
SMTP_USER_ALUNOS=
SMTP_PASS_ALUNOS=
